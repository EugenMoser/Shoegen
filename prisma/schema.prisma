generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  password String
  role     Role   @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shoe {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  price       Float
  brand       String
  currency    Currency @default(EUR)

  // Size & Meta
  sizes    String[]
  isActive Boolean  @default(true)

  // Technical classification (important for AI!)
  category   ShoeCategory[]
  usage      ShoeUsage[]
  terrain    Terrain[]
  season     Season[]
  waterproof Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum ShoeCategory {
  SNEAKER
  RUNNING
  HIKING
  SANDAL
  BOOT
}

enum ShoeUsage {
  DAILY
  SPORTS
  CASUAL
  RUNNING
  HIKING
  TREKKING
  WORK
}

enum Terrain {
  CITY
  TRAIL
  MOUNTAIN
  INDOOR
  OUTDOOR
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL_SEASON
}

enum Currency {
  USD
  EUR
  GBP
  JPY
}
